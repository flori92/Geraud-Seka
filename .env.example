# SEKA - Variables d'Environnement

# Server
PROJECT_NAME=SEKA Backend
ENVIRONMENT=production
DEBUG=false

# Security
SECRET_KEY=CHANGEME_GENERATE_RANDOM_SECRET_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
TOKEN_ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+psycopg://user:password@host:5432/seka

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=seka-documents
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Mindee OCR
MINDEE_API_KEY=your_mindee_api_key

# Sentry Monitoring
SENTRY_DSN=your_sentry_dsn

# Payment Providers
STRIPE_API_KEY=your_stripe_key
KKIAPAY_PRIVATE_KEY=your_kkiapay_key

# Email (Resend)
RESEND_API_KEY=your_resend_key
