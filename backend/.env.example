# Database
DATABASE_URL=postgresql://user:password@localhost:5432/seka

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=seka-documents

# Mindee OCR
MINDEE_API_KEY=your-mindee-api-key

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# KKiaPay
KKIAPAY_PUBLIC_KEY=your-kkiapay-public-key
KKIAPAY_PRIVATE_KEY=your-kkiapay-private-key

# Sentry
SENTRY_DSN=your-sentry-dsn

# Email
RESEND_API_KEY=your-resend-api-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
