# Configuration Production SEKA
# Variables d'environnement pour la production

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
NODE_ENV=production

# URLs PRINCIPALES - TOUJOURS HTTPS EN PRODUCTION
NEXT_PUBLIC_API_BASE_URL=https://api.sekagestion.com
NEXT_PUBLIC_FRONTEND_URL=https://www.sekagestion.com

# ===========================================
# BACKEND CONFIGURATION
# ===========================================
ENVIRONMENT=production

# URLs et domaines
FRONTEND_URL=https://www.sekagestion.com
API_DOMAIN=api.sekagestion.com
FRONTEND_DOMAIN=www.sekagestion.com

# CORS - Origines autorisées (séparées par des virgules)
BACKEND_CORS_ORIGINS=https://www.sekagestion.com,https://sekagestion.com,https://app.sekagestion.com,https://api.sekagestion.com

# Base de données
DATABASE_URL=postgresql+psycopg://user:password@host:port/database

# Sécurité
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# ===========================================
# REDIRECTIONS ET SÉCURITÉ
# ===========================================
# Force HTTPS (défini automatiquement en production)
FORCE_HTTPS=true

# Headers de sécurité (défini automatiquement)
ENABLE_SECURITY_HEADERS=true

# ===========================================
# LOGGING ET MONITORING
# ===========================================
LOG_LEVEL=INFO
ENABLE_MONITORING=true

# Sentry (optionnel)
SENTRY_DSN=your-sentry-dsn-here

# ===========================================
# CONFIGURATION OAUTH/EXTERNAL SERVICES  
# ===========================================
# Ajoutez ici vos clés API externes si nécessaires